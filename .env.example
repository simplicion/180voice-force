# ==============================================================================
# Voice Force: Autonomous AI Telephony Studio & Operations Platform
# Root Monorepo Environment Configuration (Example)
# ==============================================================================

# Core Ports & URLs
NODE_ENV=development
PORT=4005
FRONTEND_PORT=3007
BACKEND_PORT=4005
CLIENT_URL=http://localhost:3007

# Dedicated PostgreSQL Database & Redis Cache
# (Default for local docker-compose: Postgres on 5434, Redis on 6380)
DATABASE_URL=postgresql://voiceforce:voiceforce_secret_2026@localhost:5434/180voiceforce_db?schema=public
REDIS_URL=redis://localhost:6380
POSTGRES_PORT=5434
REDIS_PORT=6380
POSTGRES_USER=voiceforce
POSTGRES_PASSWORD=voiceforce_secret_2026
POSTGRES_DB=180voiceforce_db

# 180 Identity SSO Configuration
NEXT_PUBLIC_180_AUTH_URL=http://localhost:3002
NEXT_PUBLIC_180_CLIENT_ID=your_180_client_id_here
NEXT_PUBLIC_180_CLIENT_SECRET=your_180_client_secret_here
JWT_SECRET=your_voiceforce_jwt_secret_min_32_characters

# Voiceforce WebRTC Audio Bridge & LiveKit Cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_WS_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_SIP_TRUNK_ID=your_livekit_sip_trunk_id

# Telephony Carrier (Telnyx SIP & Programmable Voice)
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_PUBLIC_KEY=your_telnyx_public_key

# Ultra-Low Latency Voice Synthesis & LLM Reasoning
CARTESIA_API_KEY=your_cartesia_api_key
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key

# Prepaid Telephony Wallet & Payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudflare R2 Object Storage (Call Recordings & Knowledge Vaults)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=voiceforce-recordings
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
