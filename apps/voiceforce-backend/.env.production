# ==============================================================================
# Voice Force Dedicated Backend & Worker (Production Configuration)
# Listening on: Port 4005 | Reverse Proxy Target
# ==============================================================================

PORT=4005
NODE_ENV=production
CLIENT_URL=https://voiceforce.vanityworkspace.com

DATABASE_URL=postgresql://voiceforce_prod:REPLACE_WITH_SECURE_PROD_PASSWORD@postgres-prod:5432/voiceforce_production?schema=public&sslmode=require
REDIS_URL=rediss://default:REPLACE_WITH_REDIS_PASSWORD@redis-prod:6379

JWT_SECRET=REPLACE_WITH_PRODUCTION_JWT_SECRET_MIN_32_CHARS

LIVEKIT_API_KEY=REPLACE_WITH_PROD_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_PROD_LIVEKIT_API_SECRET
LIVEKIT_WS_URL=wss://voice.vanityworkspace.livekit.cloud
LIVEKIT_SIP_TRUNK_ID=REPLACE_WITH_PROD_SIP_TRUNK_ID

TELNYX_API_KEY=REPLACE_WITH_PROD_TELNYX_KEY
TELNYX_PUBLIC_KEY=REPLACE_WITH_PROD_TELNYX_PUBLIC_KEY

CARTESIA_API_KEY=REPLACE_WITH_PROD_CARTESIA_KEY
GROQ_API_KEY=REPLACE_WITH_PROD_GROQ_KEY
OPENAI_API_KEY=REPLACE_WITH_PROD_OPENAI_KEY

RAZORPAY_KEY_ID=REPLACE_WITH_PROD_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_PROD_RAZORPAY_SECRET

R2_ACCESS_KEY_ID=REPLACE_WITH_PROD_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_PROD_R2_SECRET_KEY
R2_BUCKET_NAME=voiceforce-production-recordings
R2_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
